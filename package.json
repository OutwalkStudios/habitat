{
    "name": "@outwalk/habitat",
    "type": "module",
    "version": "0.2.0",
    "description": "Habitat — a modern environment orchestration tool.",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "bin": {
        "habitat": "dist/index.js"
    },
    "scripts": {
        "build": "rollup -c",
        "lint": "eslint src",
        "prepublishOnly": "npm run lint && npm run build"
    },
    "keywords": [
        "docker",
        "env",
        "production",
        "development",
        "deployment"
    ],
    "files": [
        "dist",
        "templates"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OutwalkStudios/habitat.git"
    },
    "bugs": {
        "url": "https://github.com/OutwalkStudios/habitat/issues"
    },
    "homepage": "https://github.com/OutwalkStudios/habitat#readme",
    "author": "Outwalk Studios <support@outwalkstudios.com> (https://www.outwalkstudios.com/)",
    "license": "MIT",
    "dependencies": {
        "chalk": "^4.1.2",
        "dotenv": "^17.4.2",
        "glob": "^13.0.6",
        "prompts": "^2.4.2",
        "yaml": "^2.9.0",
        "yargs-parser": "^22.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "esbuild": "^0.28.0",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "rollup": "^4.61.0",
        "rollup-plugin-esbuild": "^6.2.1"
    }
}
